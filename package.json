{
  "name": "criteriatrace",
  "version": "0.1.0",
  "description": "Trace every acceptance criterion to code, tests, and executable evidence.",
  "type": "module",
  "main": "./dist/index.js",
  "engines": {
    "node": ">=20.19.0 || >=22.13.0 || >=24.0.0"
  },
  "bin": {
    "criteriatrace": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "action/dist/",
    "action.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:action",
    "build:action": "ncc build dist/action/index.js -o action/dist --license licenses.txt",
    "demo": "node dist/cli.js demo",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"import('node:fs').then(fs => { fs.rmSync('dist', {recursive:true, force:true}); fs.rmSync('action/dist', {recursive:true, force:true}); })\"",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "acceptance-criteria",
    "traceability",
    "testing",
    "evidence",
    "github-action"
  ],
  "author": "Serpufe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Serpufe/criteriatrace.git"
  },
  "bugs": {
    "url": "https://github.com/Serpufe/criteriatrace/issues"
  },
  "homepage": "https://github.com/Serpufe/criteriatrace#readme",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "commander": "^15.0.0",
    "openai": "^7.23.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
